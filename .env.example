# Скопируйте в .env для локального запуска. В GitHub — Settings → Secrets and variables → Actions.
# Файл .env в git не попадает. Токены не вставляйте в чат.

# OpenAI API (модель gpt-5.6-terra, см. config.yaml)
OPENAI_API_KEY=

# Telegram: токен бота от @BotFather, ID канала (вида -100… или @username), ваш личный chat id для оповещений
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
ADMIN_CHAT_ID=

# Notion: токен внутренней интеграции и ID страницы «Vibe Stack», расшаренной на интеграцию
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=

# Необязательно локально: повышает лимиты GitHub API (в Actions подставляется автоматически)
GITHUB_TOKEN=
